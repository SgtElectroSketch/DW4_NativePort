{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dw4:native:adventure-profile:1",
  "type": "object",
  "required": ["magic", "version", "rng_compatibility", "name", "gender", "message_speed", "chapter", "frame", "random_engine", "random_draws", "checksum"],
  "properties": {
    "magic": { "const": "DW4_NATIVE_ADVENTURE" },
    "version": { "type": "integer", "const": 1 },
    "rng_compatibility": { "type": "string", "minLength": 1 },
    "name": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "integer", "minimum": 0, "maximum": 140 } },
    "gender": { "type": "integer", "minimum": 0, "maximum": 1 },
    "message_speed": { "type": "integer", "minimum": 0, "maximum": 7 },
    "chapter": { "type": "integer", "minimum": 1, "maximum": 5 },
    "frame": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "random_engine": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "random_draws": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "checksum": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
  },
  "$comment": "Native profile container only, not complete gameplay state. zlib CRC-32 covers nlohmann-json's canonical dump without the checksum field. Names must contain a nonblank glyph. Exact RNG compatibility and complete engine decoding are required. Slot writes are flushed and atomically replaced by Desktop; backups remain local. Party, inventory, flags, world location and chapter progression will require a versioned extension before Continue is enabled."
}