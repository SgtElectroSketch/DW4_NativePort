{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dw4:native-assets:title:1",
  "type": "object",
  "required": ["schema_version", "image", "tiles", "artwork_frame", "fade_frames", "loop_start", "loop_frames", "palettes", "frames", "exit_frames"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "image": { "const": "patterns.png" },
    "tiles": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "artwork_frame": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "fade_frames": { "type": "integer", "minimum": 1, "maximum": 120 },
    "loop_start": { "type": "integer", "minimum": 0, "maximum": 3600 },
    "loop_frames": { "type": "integer", "minimum": 1, "maximum": 2048 },
    "palettes": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/color" } }
    },
    "draw_records": { "type": "array", "maxItems": 131072, "items": { "$ref": "#/$defs/draw" } },
    "frames": { "$ref": "#/$defs/frames" },
    "exit_frames": { "$ref": "#/$defs/frames" },
    "music": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "required": ["frame", "track"],
        "properties": {
          "frame": { "type": "integer", "minimum": 0, "maximum": 3600 },
          "track": { "type": "integer", "minimum": 1, "maximum": 127 }
        }
      }
    }
  },
  "$defs": {
    "color": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
    "draw": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 8191 },
        { "type": "integer", "minimum": -7, "maximum": 255 },
        { "type": "integer", "minimum": -7, "maximum": 239 },
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "integer", "minimum": 0, "maximum": 3 },
        { "type": "integer", "minimum": 0, "maximum": 239 },
        { "type": "integer", "minimum": 1, "maximum": 240 }
      ]
    },
    "frames": {
      "type": "array", "maxItems": 3600,
      "items": {
        "type": "object", "required": ["background", "draws"],
        "properties": {
          "background": { "$ref": "#/$defs/color" },
          "draws": {
            "type": "array", "maxItems": 4096,
            "items": { "oneOf": [{ "$ref": "#/$defs/draw" }, { "type": "integer", "minimum": 0, "maximum": 131071 }] }
          }
        }
      }
    }
  },
  "$comment": "Runtime additionally validates references, clip endpoints, ordered music cues, loop range and fade-frame count. Developer extraction normalizes sprite/background priority and raster composition. No original instructions or RAM layout run in native playback."
}